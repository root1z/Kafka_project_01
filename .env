# =============================================
# KAFKA CONFIGURATION
# =============================================

# Kafka Bootstrap Servers
KAFKA_BOOTSTRAP_SERVERS=localhost:9094,localhost:9194,localhost:9294

# Security Protocol
KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT

# SASL Configuration
KAFKA_SASL_MECHANISMS=PLAIN
KAFKA_USERNAME=kafka
KAFKA_PASSWORD=UnigapKafka@2024

# =============================================
# PRODUCER CONFIGURATION
# =============================================

KAFKA_PRODUCER_ACK=all
KAFKA_PRODUCER_ENABLE_IDEMPOTENCE=true
KAFKA_PRODUCER_COMPRESSION_TYPE=snappy

# =============================================
# CONSUMER CONFIGURATION
# =============================================

KAFKA_CONSUMER_GROUP=data-processing-group
KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
KAFKA_CONSUMER_ENABLE_AUTO_COMMIT=false
KAFKA_CONSUMER_MAX_POLL_INTERVAL_MS=30000

# =============================================
# PRODUCER CONFIGURATION
# =============================================
KAFKA_PRODUCER_ACK=all
KAFKA_PRODUCER_RETRIES=3
KAFKA_PRODUCER_ENABLE_IDEMPOTENCE=true
KAFKA_PRODUCER_COMPRESSION_TYPE=snappy


# =============================================
# TOPIC NAMES
# =============================================

KAFKA_INPUT_TOPIC=data-input-topic
KAFKA_OUTPUT_TOPIC=data-output-topic

# =============================================
# APPLICATION SETTINGS
# =============================================

# Batch Processing
BATCH_SIZE=100
MAX_POLL_RECORDS=500
POLL_TIMEOUT_MS=1000

# Retry Configuration
MAX_RETRY_ATTEMPTS=3

# Performance Tuning
SESSION_TIMEOUT_MS=10000
SOCKET_TIMEOUT_MS=30000

# =============================================
# MONITORING AND LOGGING
# =============================================

LOG_LEVEL=INFO
METRICS_ENABLED=true
STATISTICS_INTERVAL_MS=10000

# =============================================
# EXTERNAL SERVICES
# =============================================

# AKHQ UI
AKHQ_URL=http://localhost:8180
AKHQ_USERNAME=admin
AKHQ_PASSWORD=Unigap@2024

# =============================================
# MONGODB CONFIGURATION
# =============================================

MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USERNAME=admin
MONGO_PASSWORD=Asd123123
MONGO_DATABASE=kafka_data
MONGO_AUTH_SOURCE=admin
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=10
MONGO_MAX_IDLE_TIME_MS=30000

# Collection Names
MONGO_COLLECTION_DATA=data_messages
MONGO_COLLECTION_ERRORS=error_messages
MONGO_COLLECTION_OFFSETS=processed_offsets

# =============================================
# SOURCE KAFKA CONFIGURATION (External Kafka)
# =============================================

SRC_KAFKA_BOOTSTRAP_SERVERS=46.202.167.130:9094,46.202.167.130:9194,46.202.167.130:9294
SRC_KAFKA_SECURITY_PROTOCOL=SASL_PLAINTEXT
SRC_KAFKA_SASL_MECHANISMS=PLAIN
SRC_KAFKA_USERNAME=kafka
SRC_KAFKA_PASSWORD=UnigapKafka@2024
SRC_KAFKA_INPUT_TOPIC=product_view
SRC_KAFKA_CONSUMER_GROUP=external-bridge-group
SRC_KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
SRC_KAFKA_CONSUMER_MAX_POLL_INTERVAL_MS=300000
